# Deployment script inputs. Never commit private keys.
# Arc scripts read ARC_PRIVATE_KEY from ignored .env.arc.local. Generate a
# dedicated testnet-only key with `npm run wallet:arc` instead of placing it here.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
FACTORY_OWNER=0x0000000000000000000000000000000000000000
COLLATERAL_ADDRESS=0x0000000000000000000000000000000000000000
MARKET_QUESTION=Will the event happen?
# Replace with a Unix timestamp in the future, for example: [DateTimeOffset]::UtcNow.AddDays(7).ToUnixTimeSeconds()
CLOSE_TIME=REPLACE_WITH_FUTURE_UNIX_TIMESTAMP
FEE_BPS=300
PROTOCOL_FEE_SHARE_BPS=2000
PROTOCOL_TREASURY=0x0000000000000000000000000000000000000000
MINIMUM_RESERVE=100000000000000000000
ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
OWNER_ADDRESS=0x0000000000000000000000000000000000000000
